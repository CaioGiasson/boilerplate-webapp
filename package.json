{
	"name": "boilerplate-webapp",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": "22.19.0"
	},
	"scripts": {
		"analyze": "ANALYZE=true next build",
		"build": "npm run prisma-merge && prisma generate && next build",
		"check": "prettier --write . && eslint .",
		"cron": "node scripts/cron/run.mjs",
		"cron:retention": "node scripts/cron/jobs/retention-purge.mjs",
		"dev": "npm run prisma-merge && prisma generate && node scripts/next-port.mjs dev",
		"email:backfill-verified": "node scripts/backfill-email-verified.mjs",
		"healthcheck": "node scripts/healthcheck.mjs",
		"lint": "eslint .",
		"list-users": "node scripts/list-users.mjs",
		"mongo:keyfile": "node scripts/generate-mongo-keyfile.mjs",
		"mongo:migrate-to-auth": "node scripts/mongo-migrate-to-auth.mjs",
		"nickname:backfill": "node scripts/backfill-nickname-canonical.mjs",
		"prepare": "husky",
		"prisma-merge": "node prisma/merge.mjs",
		"prisma:generate": "npm run prisma-merge && prisma generate",
		"prisma:push": "npm run prisma-merge && prisma db push",
		"smoke:multi-instance": "node scripts/multi-instance-smoke.mjs",
		"spaces:make-private": "node scripts/migrate-spaces-private.mjs",
		"spaces:migrate-keys": "node scripts/migrate-spaces-keys.mjs",
		"spaces:purge-orphans": "node scripts/purge-orphan-files.mjs",
		"start": "node scripts/next-port.mjs start",
		"test": "jest",
		"test-email": "node scripts/test-email.mjs",
		"test-environment": "node scripts/test-environment.mjs",
		"typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
		"unconfirm-account": "node scripts/unconfirm-account.mjs"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1107.0",
		"@aws-sdk/s3-request-presigner": "^3.1114.0",
		"@prisma/client": "5.22.0",
		"@radix-ui/react-accordion": "^1.2.20",
		"@radix-ui/react-avatar": "^1.2.6",
		"@radix-ui/react-dialog": "^1.1.6",
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@radix-ui/react-label": "^2.1.2",
		"@radix-ui/react-select": "^2.1.6",
		"@radix-ui/react-slider": "^1.4.7",
		"@radix-ui/react-slot": "^1.1.2",
		"@radix-ui/react-switch": "^1.1.3",
		"@radix-ui/react-toast": "^1.2.23",
		"@radix-ui/react-tooltip": "^1.1.8",
		"argon2": "^0.45.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"jose": "^6.2.8",
		"lucide-react": "^0.475.0",
		"next": "15.5.23",
		"next-intl": "^4.9.2",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"tailwind-merge": "^2.6.0",
		"undici": "^8.10.0",
		"zod": "3.24.2"
	},
	"devDependencies": {
		"@eslint/eslintrc": "3.3.1",
		"@next/bundle-analyzer": "^15.5.23",
		"@tailwindcss/postcss": "^4",
		"@types/argon2": "^0.14.1",
		"@types/jest": "29.5.14",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"dotenv": "16.4.7",
		"eslint": "^9",
		"eslint-config-next": "15.5.23",
		"husky": "9.1.7",
		"jest": "29.7.0",
		"jest-environment-jsdom": "^29.7.0",
		"lint-staged": "15.5.1",
		"prettier": "3.5.3",
		"prisma": "5.22.0",
		"tailwindcss": "^4",
		"ts-jest": "29.2.6",
		"typescript": "^5"
	},
	"lint-staged": {
		"**/*": "prettier --write --ignore-unknown"
	}
}
