# MongoDB (Docker Compose). Generate password: openssl rand -base64 24
# If the password contains @ : / ? # [ ] % use URL-encoding in DATABASE_URL.
MONGO_ROOT_USERNAME="mongo"
MONGO_ROOT_PASSWORD="change-me-generate-with-openssl-rand-base64-24"
DATABASE_URL="mongodb://mongo:change-me-generate-with-openssl-rand-base64-24@localhost:27717/mongo?replicaSet=rs0&directConnection=true&authSource=admin&connection_limit=10"
# Per-instance Mongo pool cap — see docs/operators/database-pool.md (formula vs N replicas).
CACHE_LIFETIME_SECONDS=21600
LOG_LEVEL=info
# JWT_SECRET must be ≥32 random characters and MUST NOT be the example placeholder below.
# If this placeholder is copied into .env, boot and healthcheck will fail.
# Generate one: openssl rand -base64 48
JWT_SECRET="change-me-in-production-use-a-long-random-string"
# Optional JWT claims (defaults: boilerplate-webapp / boilerplate-webapp-web)
# JWT_ISSUER="boilerplate-webapp"
# JWT_AUDIENCE="boilerplate-webapp-web"
JWT_TTL_SECONDS=604800
# Object storage region: nyc3 = DigitalOcean Spaces datacenter in the USA (New York 3).
# Storing user images there is an international transfer (LGPD / GDPR). Operator must
# have a signed DigitalOcean DPA (and SCCs for EEA subjects) — see docs/operators/transfers.md.
# Future region options (do not switch without updating privacy policy + transfers.md first):
#   gru1 (Brazil), fra1 (Frankfurt). Default remains nyc3 to avoid breaking current deploys.
SPACES_ENDPOINT="nyc3.digitaloceanspaces.com"
SPACES_BUCKET="app"
SPACES_ACCESS_KEY_ID=""
SPACES_SECRET_ACCESS_KEY=""
# Canonical base URL (used to derive object keys). Bucket must be private; app serves presigned GET URLs.
SPACES_PUBLIC_BASE_URL=""
ENVIRONMENT="dev"
# Optional. When set, /api/health* also accepts this token (header x-healthcheck-token
# or Authorization: Bearer). When unset, only loopback (127.0.0.1 / ::1) is allowed.
# HEALTHCHECK_TOKEN=""

# API docs (Swagger UI). Disabled by default. When enabled, Basic auth is mandatory.
# SWAGGER_ENABLED=false
# SWAGGER_USER=""
# SWAGGER_PASSWORD=""
# UI: GET /api/docs · Spec: GET /api/docs/openapi · Source: docs/openapi.yaml

# Transactional email (see docs/operators/email.md). Callers use EmailService only.
# development: omit or EMAIL_PROVIDER=none (noop). production-like: must be brevo.
EMAIL_PROVIDER="none"
# EMAIL_FROM="noreply@example.com"
# EMAIL_FROM_NAME="App"
# BREVO_API_KEY=""
# BREVO_API_BASE_URL="https://api.brevo.com"
# EMAIL_TIMEOUT_MS=10000
# BREVO_SANDBOX=false
# Public app origin used in verification / email-change links (no trailing slash).
# APP_BASE_URL="http://localhost:3000"

# Operator-local only: `npm run export-from-pinterest`. The Next.js app never reads this.
# Prefer `.pinterest-cookies.json` (gitignored). Do not deploy this value with the app.
# Sem login o Pinterest limita o feed (~21 pins por board).
# No Chrome, em uma aba já logada: DevTools → Application → Cookies → pinterest.com
# Copie _auth, csrftoken e _pinterest_sess (HttpOnly; não aparece em document.cookie).
# PINTEREST_COOKIES="_auth=1; csrftoken=...; _pinterest_sess=..."

# HTTP listen port for `npm run dev` / `npm run start` (default 3000).
# Keep APP_BASE_URL and GOOGLE_OAUTH_REDIRECT_URI in sync with this port.
SERVER_PORT=3000

# Google OAuth (optional — without these, "Continue with Google" is hidden)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
# GOOGLE_OAUTH_TIMEOUT_MS=10000
