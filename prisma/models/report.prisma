enum ReportReason {
  spam
  nudes_nonconsensual
  csam
  impersonation
  other
}

enum ReportStatus {
  open
  reviewing
  closed
}

model Report {
  id         String       @id @default(auto()) @map("_id") @db.ObjectId
  imageId    String       @db.ObjectId
  reporterId String       @db.ObjectId
  reason     ReportReason
  details    String?
  status     ReportStatus @default(open)
  createdAt  DateTime     @default(now())

  @@unique([imageId, reporterId])
  @@index([imageId])
  @@index([status])
}
