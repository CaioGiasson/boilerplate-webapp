@baseUrl = http://localhost:3000
@imageId = {{imageId}}

### List my images
GET {{baseUrl}}/api/v1/images?scope=mine
Accept: application/json

###
### List global mosaic
GET {{baseUrl}}/api/v1/images?scope=all&q=landscape
Accept: application/json

###
### Create image from data URL
POST {{baseUrl}}/api/v1/images
Content-Type: application/json

{
  "image": "data:image/jpeg;base64,/9j/4AAQSkZJRg==",
  "title": "Sunset",
  "description": "Beach sunset",
  "tags": ["nature", "beach"],
  "visibility": "PUBLIC"
}

###
### Get image by id
GET {{baseUrl}}/api/v1/images/{{imageId}}
Accept: application/json

###
### Update image metadata
PATCH {{baseUrl}}/api/v1/images/{{imageId}}
Content-Type: application/json

{
  "title": "Updated title",
  "tags": ["nature"]
}

###
### Change image visibility
PATCH {{baseUrl}}/api/v1/images/{{imageId}}/visibility
Content-Type: application/json

{
  "visibility": "PRIVATE"
}

###
### Delete image
DELETE {{baseUrl}}/api/v1/images/{{imageId}}

###
### Report image
POST {{baseUrl}}/api/v1/images/{{imageId}}/report
Content-Type: application/json

{
  "reason": "spam",
  "details": "Optional details"
}

###
### Import image from URL
POST {{baseUrl}}/api/v1/images/from-url
Content-Type: application/json

{
  "url": "https://example.com/photo.jpg",
  "title": "Imported",
  "visibility": "PUBLIC"
}

###
### List image tags
GET {{baseUrl}}/api/v1/images/tags?scope=mine
Accept: application/json
