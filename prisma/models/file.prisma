enum FileStatus {
  pending
  published
  failed
  orphan
}

model File {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  key       String     @unique
  url       String
  category  String
  mimeType  String
  /// Soma do objeto principal e do thumbnail (conta na cota). Arquivos legados não têm thumbnail.
  sizeBytes Int
  /// URL canônica e chave do thumbnail WebP de 200 px; ausentes em arquivos anteriores ao pipeline de imagem.
  thumbnailUrl String?
  thumbnailKey String?
  status    FileStatus @default(pending)
  ownerId   String?    @db.ObjectId
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([ownerId, status])
  @@index([status])
}
